# Copy to .env and adjust. All values are optional.

# Port Jellyflow is exposed on your machine (mapped to the container's 8080).
PORT=8080

# If set, Jellyflow proxies to this server and users only enter credentials.
# Docker-network hostnames work when both containers share a network, for example:
# JELLYFIN_URL=http://jellyfin:8096
# Leave blank to let users choose a server on the connect screen.
JELLYFIN_URL=
